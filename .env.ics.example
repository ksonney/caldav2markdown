# ICS Source Mode Configuration Examples

# Source mode (caldav or ics) - defaults to caldav for backward compatibility
SOURCE_MODE=ics

# === Local ICS File ===
# Use this for local ICS files
# ICS_PATH=/path/to/your/calendar.ics

# === Remote ICS File ===
# Use this for remote ICS URLs (Google Calendar public URLs, webcal://, etc.)
# ICS_URL=https://calendar.google.com/calendar/ical/example%40gmail.com/public/basic.ics

# === Authentication for Remote ICS ===
# Authentication method: none, basic, bearer, header
ICS_AUTH=none

# For basic authentication
# ICS_USERNAME=your_username
# ICS_PASSWORD=your_password

# For bearer token authentication
# ICS_AUTH=bearer
# ICS_TOKEN=your_bearer_token

# For custom header authentication
# ICS_AUTH=header
# ICS_HEADER_Authorization=Bearer your_token
# ICS_HEADER_X-API-Key=your_api_key

# HTTP timeout for remote requests (default: 30s)
# ICS_TIMEOUT=30s

# === Common Configuration ===
OUTPUT_DIR=./events
START_DATE=2025-01-01
END_DATE=2025-12-31

# Formatting options
USE_FRONTMATTER=true
USE_HASHTAGS=true
USE_DUE_DATE_EMOJI=true