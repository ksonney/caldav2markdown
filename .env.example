# CalDAV2Markdown Configuration File

# CalDAV Server URL (required)
CALDAV_URL=https://caldav.example.com/calendars/

# Authentication Method 1: Basic Auth (traditional)
CALDAV_USERNAME=your_username
CALDAV_PASSWORD=your_password

# Authentication Method 2: OAuth 2.0 (for Google Calendar)
# Set USE_OAUTH=true to enable OAuth authentication
USE_OAUTH=false
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Output directory for markdown files
OUTPUT_DIR=./events

# Date Range Configuration (optional)
# Filter events and tasks within this date range
# Format: YYYY-MM-DD
# If not specified, defaults to 2000-01-01 to 2 years from now
START_DATE=2000-01-01
END_DATE=2027-01-01

# Formatting Options (optional)
# Use 📅 emoji for due dates in tasks instead of "Due:"
USE_DUE_DATE_EMOJI=false

# Add #event and #task hashtags to items
USE_HASHTAGS=false

# Add YAML frontmatter to markdown files with metadata
USE_FRONTMATTER=false

# Performance Options (optional)
# Use CalDAV server-side filtering (faster for large calendars)
USE_SERVER_SIDE_FILTERING=false

# Multi-Calendar Options (optional)
# Discover and process all calendars on the server
DISCOVER_CALENDARS=false
# Include only specific calendars (comma-separated names or URLs)
INCLUDE_CALENDARS=Work,Personal
# Exclude specific calendars (comma-separated names or URLs)
EXCLUDE_CALENDARS=Archive,Test

# Google Calendar CalDAV URL format:
# For Google Calendar, use: https://apidata.googleusercontent.com/caldav/v2/primary/events
# Replace 'primary' with specific calendar ID if needed